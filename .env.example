# Copy to .env (git-ignored) only if you need it. The default run, tests and evaluation need NO .env:
# the host generates fresh signing keys for every run. Every variable the system reads is listed here.

# --- Model provider: these two switch it (local Ollama shown; hosted: https://api.openai.com/v1) ---
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# Hosted providers only. Never commit a real key.
LLM_API_KEY=your-api-key-here
# mock | faulty | openai   (openai = use the endpoint above)
AGENT_MODEL=mock
LLM_TEMPERATURE=0
# Seconds per model call
LLM_TIMEOUT=180

# --- Signing keys (optional). Leave empty to get fresh random keys on every run.
# To fix them, put 64 hex chars each:  python -c "import secrets; print(secrets.token_hex(32))"
AMBULANCE_SESSION_KEY=
AMBULANCE_APPROVAL_KEY=

# --- Server-side settings (normally set by the host when it launches the server)
# stdio only; issued by the host (see scripts/dev_session.py env)
AMBULANCE_SESSION_TOKEN=
AMBULANCE_AUDIT_PATH=project/runtime/audit.jsonl
# on | off   (off = evaluation ablation only; refused over HTTP)
AMBULANCE_GATES=on
