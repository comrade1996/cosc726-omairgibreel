# Copy to .env (git-ignored) only if you need one. The offline demo, tests and evaluation need NO .env:
# the host generates fresh signing keys for every run.

# --- Optional: fixed signing keys (64 hex chars each), e.g. to run the HTTP server and client separately.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
AMBULANCE_SESSION_KEY=
AMBULANCE_APPROVAL_KEY=

# --- Optional: real LLM for the agent (--model openai). Any OpenAI-compatible endpoint.
# Local open-weight model with Ollama (no key):  ollama pull qwen2.5:7b-instruct
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=
LLM_TEMPERATURE=0
# Hosted alternative: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=<model>  LLM_API_KEY=<your key, never commit>
